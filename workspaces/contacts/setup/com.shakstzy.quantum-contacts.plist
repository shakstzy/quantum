<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily contacts ingest at 4am. Runs ingest then classify. Idempotent on re-runs. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shakstzy.quantum-contacts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/shakstzy/QUANTUM/workspaces/contacts &amp;&amp; bash scripts/pull.sh &gt;&gt; ~/Library/Logs/quantum-contacts.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/shakstzy/Library/Logs/quantum-contacts.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/shakstzy/Library/Logs/quantum-contacts.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
