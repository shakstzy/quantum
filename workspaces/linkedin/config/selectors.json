{
  "_comment": "Selector chains. First match wins. Update via diag.mjs when LinkedIn ships a UI variant.",
  "login": {
    "email": [
      "input[autocomplete=\"username\"]",
      "input[name=\"session_key\"]",
      "input#username",
      "form input[type=\"text\"]"
    ],
    "password": [
      "input[autocomplete=\"current-password\"]",
      "input[name=\"session_password\"]",
      "input#password",
      "input[type=\"password\"]"
    ],
    "submit": [
      "form button[type=\"submit\"]",
      "button[aria-label=\"Sign in\"]",
      "button[data-litms-control-urn*=\"login-submit\"]"
    ]
  },
  "comply_gate": [
    "button#content__button--primary--muted",
    "button.content__button--primary",
    "button:has-text(\"Agree to comply\")"
  ],
  "checkpoint": [
    "input[name=\"pin\"]",
    "input[autocomplete=\"one-time-code\"]",
    "form[action*=\"/checkpoint\"] input[type=\"text\"]"
  ],
  "captcha": [
    "iframe[src*=\"recaptcha\"]",
    "iframe[title*=\"captcha\" i]",
    "div#captcha-internal"
  ],
  "weekly_invite_limit": [
    "div[class*=\"ip-fuse-limit-alert__warning\"]",
    "div:has-text(\"You've reached the weekly invitation limit\")"
  ],
  "connect": {
    "top_card": [
      "section.pv-top-card",
      "section[data-member-id]",
      "main section:has(h1)"
    ],
    "direct": [
      "[aria-label*=\"Invite\"][aria-label*=\"to connect\"]:visible",
      "button:has(span:text-is(\"Connect\")):visible",
      "a:has(span:text-is(\"Connect\")):visible"
    ],
    "more_button": [
      "button[aria-label=\"More\"]:visible",
      "button[id*=\"overflow\"]:visible",
      "button[aria-label*=\"More actions\"]:visible"
    ],
    "menu_connect": [
      "div[role=\"button\"][aria-label^=\"Invite\"][aria-label*=\"to connect\"]",
      "[role=\"menuitem\"][aria-label*=\"Connect\"]",
      "[role=\"menuitem\"]:has-text(\"Connect\")"
    ],
    "send_now": [
      "button:has-text(\"Send without a note\")",
      "button[aria-label*=\"Send invitation\"]",
      "button:has-text(\"Send now\")"
    ],
    "error_toast": [
      "div[data-test-artdeco-toast-item-type=\"error\"]"
    ]
  }
}
