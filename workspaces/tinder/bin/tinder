#!/usr/bin/env bash
# CLI wrapper for the QUANTUM Tinder workspace.
# Usage: ./bin/tinder <swipe|pull|decide|send|status|pending|approve|reject|selector-check|self-check|halt|unhalt>

set -euo pipefail

WS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BOT_DIR="$WS_ROOT/bot"

cmd="${1:-help}"
shift || true

case "$cmd" in
  swipe)            node "$BOT_DIR/scripts/swipe.mjs" "$@" ;;
  pull)             node "$BOT_DIR/scripts/pull.mjs" "$@" ;;
  decide)           node "$BOT_DIR/scripts/decide.mjs" "$@" ;;
  send)
    if [[ $# -eq 0 ]]; then
      node "$BOT_DIR/scripts/send.mjs"
    else
      # send a specific item from pending: move it to approved first, then run send
      id="$1"
      mv "$WS_ROOT/04-outbound/pending/$id.md" "$WS_ROOT/04-outbound/approved/$id.md"
      node "$BOT_DIR/scripts/send.mjs"
    fi
    ;;
  status)           node "$BOT_DIR/scripts/status.mjs" ;;
  pending)
    ls -1t "$WS_ROOT/04-outbound/pending/"*.md 2>/dev/null | while read -r f; do
      id="$(basename "$f" .md)"
      person="$(grep '^person:' "$f" | head -1 | cut -d: -f2- | xargs)"
      created="$(grep '^created:' "$f" | head -1 | cut -d: -f2- | xargs)"
      mode="$(grep '^mode:' "$f" | head -1 | cut -d: -f2- | xargs)"
      printf "%s  %-20s  %s  %s\n" "$created" "$person" "$mode" "$id"
    done
    ;;
  approve)
    [[ -z "${1:-}" ]] && { echo "usage: tinder approve <id>"; exit 1; }
    mv "$WS_ROOT/04-outbound/pending/$1.md" "$WS_ROOT/04-outbound/approved/$1.md"
    echo "approved: $1"
    ;;
  reject)
    [[ -z "${1:-}" ]] && { echo "usage: tinder reject <id>"; exit 1; }
    mv "$WS_ROOT/04-outbound/pending/$1.md" "$WS_ROOT/04-outbound/expired/$1.md"
    echo "rejected: $1"
    ;;
  selector-check)   node "$BOT_DIR/scripts/selector-check.mjs" ;;
  self-check)       node "$BOT_DIR/scripts/self-check.mjs" ;;
  halt)
    mkdir -p "$HOME/.quantum/tinder"
    echo "$(date -Iseconds): manual halt by user" > "$HOME/.quantum/tinder/.halt"
    echo "halted"
    ;;
  unhalt)
    rm -f "$HOME/.quantum/tinder/.halt"
    echo "unhalted"
    ;;
  help|--help|-h)
    cat <<USAGE
quantum-tinder CLI

Sessions:
  swipe              Run one swipe session (subject to caps)
  pull               Scrape matches + thread snapshots into raw/tinder/
  decide             Cross-ref iMessage, draft replies, queue to outbound
  send [id]          Drain approved queue (or approve+send a single pending id)
  status             Print today's counters, queue sizes, halt state

Outbound queue:
  pending            List items awaiting approval
  approve <id>       Move pending -> approved (next send invocation picks up)
  reject  <id>       Move pending -> expired

Maintenance:
  self-check         Pre-flight env / deps / config / halt
  selector-check     Interactive DOM selector verification (launches browser)
  halt               Set halt flag (blocks all sessions)
  unhalt             Clear halt flag
USAGE
    ;;
  *)
    echo "unknown command: $cmd. try './bin/tinder help'"
    exit 1
    ;;
esac
